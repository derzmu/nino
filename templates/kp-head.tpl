		[assets /.cache/style.css]

		<!-- MusicGroup statt LocalBusiness - eine Band ist kein Ladengeschäft,
		     und Google/Spotify lesen genau dieses Schema für Künstlerprofile -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "MusicGroup",
			"name": "[[/company/name]]",
			"description": "[[/company/description]]",
			"url": "https://[[/website/url]]",
			"email": "[[/company/email]]",
			"genre": "[[/band/genre]]",
			"sameAs": [ "[[/social/facebook]]", "[[/social/instagram]]" ]
		}
		</script>
	</head>
